{
  "name": "web-cron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多功能 cron 调度器：定时访问设定网址，支持 HTTP 请求与真实浏览器仿真双模式",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node test/unit.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "ssh2": "^1.17.0"
  },
  "optionalDependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
